      ]
    },
    {
      "name": "12 - Update Task Status to done",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}/status"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"done\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status tugas diperbarui', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
