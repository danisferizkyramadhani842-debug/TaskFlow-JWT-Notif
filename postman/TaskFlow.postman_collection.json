          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/notifications/token"
        },
        "description": "Isi collection variable expoPushToken dengan token perangkat asli dari layar Aktifkan Notifikasi. Jangan menggunakan placeholder sebagai bukti.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expoPushToken\": \"{{expoPushToken}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
